[sub_resource type="Shader" id="Shader_barrier"]
code = "shader_type spatial;
render_mode blend_add, depth_draw_never, cull_disabled, unshaded;

uniform vec4 shield_color : source_color = vec4(0.0, 0.8, 1.0, 1.0);
uniform float line_thickness = 0.05;
uniform float speed = 1.0;
uniform float hexes_around = 60.0; // Должно быть четным!

varying vec3 local_pos;

void vertex() {
    local_pos = VERTEX;
}

// Абсолютно надежный алгоритм гексагональной сетки
float hexGrid(vec2 uv) {
    vec2 p = uv;
    p.x *= 1.1547005; // 2.0 / sqrt(3.0)
    p.y += mod(floor(p.x), 2.0) * 0.5; // Смещение каждого второго столбца
    p = abs(mod(p, 1.0) - 0.5); // Локальные координаты
    // Дистанция до ребра шестиугольника
    return abs(max(p.x * 1.5 + p.y, p.y * 2.0) - 1.0);
}

void fragment() {
    // ЗАБУДЕМ ПРО UV! CSGCylinder3D сжимает весь паттерн на стыковочном полигоне.
    // Считаем цилиндрические координаты прямо из 3D позиции вершины:
    float angle = atan(local_pos.x, local_pos.z); // От -PI до PI
    float u = (angle + 3.14159265) / (2.0 * 3.14159265); // От 0 до 1
    
    // Масштабируем так, чтобы по кругу было ровно hexes_around хексов
    // Делим на 1.1547005, чтобы компенсировать масштабирование внутри hexGrid
    float x_coord = u * hexes_around / 1.1547005;
    
    // Радиус 200 -> Периметр 1256.637. Высота хекса = Периметр / hexes_around
    float y_coord = local_pos.y / (1256.637 / hexes_around);
    
    float dist = hexGrid(vec2(x_coord, y_coord));
    
    // Фиксированное сглаживание вместо fwidth, чтобы избежать артефакта на шве atan
    float fw = 0.03;
    float line = 1.0 - smoothstep(line_thickness - fw, line_thickness + fw, dist);
    
    float wave = (sin(local_pos.y * 0.1 - TIME * speed) + 1.0) * 0.5;
    float brightness = mix(0.5, 1.0, wave);
    
    // Затухание сверху и снизу (высота барьера от -500 до +500)
    float fade_top = smoothstep(500.0, 450.0, local_pos.y);
    float fade_bot = smoothstep(-500.0, -450.0, local_pos.y);
    float edge_fade = fade_top * fade_bot;
    
    float alpha = max(line, 0.05) * brightness * shield_color.a * edge_fade;
    
    ALBEDO = shield_color.rgb * (1.0 + line * 2.0); // Линии светятся ярче
    ALPHA = clamp(alpha, 0.0, 1.0);
}
"

